<%- include('_top') %>
<header class="adm-head">
  <div>
    <h1>Users</h1>
    <p class="adm-sub">Everyone who can chat. You see counts and money only, never message text.</p>
  </div>
  <button type="button" class="btn btn-primary" data-pay-user=""><i class="bi bi-cash-coin me-2"></i>Record payment</button>
</header>

<form class="filters" method="get" action="/admin/users" role="search">
  <div class="filter-search">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input type="search" class="form-control" name="q" value="<%= query.q %>" placeholder="Search username" aria-label="Search username" maxlength="50">
  </div>
  <select class="form-select" name="status" aria-label="Status">
    <option value="all"<%= query.status === 'all' ? ' selected' : '' %>>All statuses</option>
    <option value="active"<%= query.status === 'active' ? ' selected' : '' %>>Active</option>
    <option value="inactive"<%= query.status === 'inactive' ? ' selected' : '' %>>Inactive</option>
  </select>
  <select class="form-select" name="sort" aria-label="Sort by">
    <option value="username"<%= query.sort === 'username' ? ' selected' : '' %>>Sort: username</option>
    <option value="balance"<%= query.sort === 'balance' ? ' selected' : '' %>>Sort: balance owed</option>
    <option value="chars"<%= query.sort === 'chars' ? ' selected' : '' %>>Sort: characters billed</option>
    <option value="paid"<%= query.sort === 'paid' ? ' selected' : '' %>>Sort: amount paid</option>
    <option value="newest"<%= query.sort === 'newest' ? ' selected' : '' %>>Sort: newest</option>
  </select>
  <button type="submit" class="btn btn-soft">Apply</button>
  <% if (query.q || query.status !== 'all' || query.sort !== 'username') { %><a class="btn btn-outline-secondary" href="/admin/users">Reset</a><% } %>
</form>

<section class="adm-card p-0">
  <% if (!users.length) { %>
    <p class="empty"><i class="bi bi-people"></i>No users match.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th scope="col">User</th><th scope="col">Status</th><th scope="col">Joined</th>
            <th scope="col" class="num">Messages</th><th scope="col" class="num">Characters billed</th>
            <th scope="col" class="num">Billed</th><th scope="col" class="num">Paid</th><th scope="col" class="num">Balance</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function (row) { %>
            <tr>
              <td><a class="person" href="/admin/users/<%= row.id %>"><%- include('../partials/avatar', { name: row.username, id: row.id, size: 'sm' }) %><strong><%= row.username %></strong></a></td>
              <td><span class="badge-soft <%= row.status === 'active' ? 'badge-active' : 'badge-inactive' %>"><%= row.status === 'active' ? 'Active' : 'Inactive' %></span></td>
              <td><time datetime="<%= row.createdAt %>" data-local="date"><%= formatUtc(row.createdAt) %></time></td>
              <td class="num"><%= row.messages.toLocaleString('en-US') %></td>
              <td class="num"><%= row.chars.toLocaleString('en-US') %></td>
              <td class="num"><%= money(row.chargedCents) %></td>
              <td class="num"><%= money(row.paidCents) %></td>
              <td class="num"><%- include('_balance', { cents: row.balanceCents }) %></td>
              <td class="actions">
                <a class="btn btn-outline-secondary btn-sm" href="/admin/users/<%= row.id %>">View</a>
                <button type="button" class="btn btn-soft btn-sm" data-pay-user="<%= row.id %>">Record payment</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('_pager', { pager, urlFor: function (page) { return pageUrl({ page: page }); } }) %>

<%- include('_payment-modal') %>
<%- include('_bottom') %>
