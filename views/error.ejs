<%- include('partials/head', { bodyClass: 'error-body' }) %>
<main class="error-shell">
  <div class="error-card">
    <img src="/images/logo.svg" alt="Bai-ber">
    <div class="code"><%= locals.status || 500 %></div>
    <h1 class="h4 mt-2 mb-2"><%= locals.title || 'Something went wrong' %></h1>
    <p class="text-muted-bb mb-4"><%= locals.message || 'Please try again.' %></p>
    <a class="btn btn-primary px-4" href="/">Back to Bai-ber</a>
  </div>
</main>
<%- include('partials/foot') %>
